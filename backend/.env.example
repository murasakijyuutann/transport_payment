# ABT backend (Phase 0+)
PORT=3000
DATABASE_URL=postgresql://transport_user:your_password@localhost:5432/transport_abt
JWT_SECRET=dev-only-change-me-32chars!!
NODE_ENV=development
MAX_JOURNEY_DURATION_HOURS=4
# Local default: cron on when NODE_ENV=development. Set false under ECS API tasks.
ENABLE_CRON=true

# Production / ECS API task example:
# NODE_ENV=production
# ENABLE_CRON=false
# Expire via EventBridge → `node dist/jobs/expireIncompleteJourneys.js`

# Vitest integration tests — optional. If unset, credentials are taken from
# DATABASE_URL above (only the database name is changed to transport_abt_test / postgres).
# TEST_DATABASE_URL=postgresql://transport_user:your_password@localhost:5432/transport_abt_test
# ADMIN_DATABASE_URL=postgresql://transport_user:your_password@localhost:5432/postgres
